{
  "name": "changelog-support",
  "displayName": "changelog-support",
  "description": "Extension to support writing ChangeLog.",
  "version": "0.2.0",
  "publisher": "kondoumh",
  "icon": "asset/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "url": "https://github.com/kondoumh/changelog-support"
  },
  "author": {
    "name": "kondoumh",
    "email": "kondoumh@gmail.com",
    "url": "https://kondoumh.com/"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.insertItem",
    "onLanguage:changelog"
  ],
  "main": "./extension",
  "contributes": {
    "commands": [
      {
        "command": "extension.insertItem",
        "title": "Insert ChangeLog Item"
      }
    ],
    "languages": [
      {
        "id": "changelog",
        "aliases": [
          "changelog"
        ],
        "filenames": [
          "ChangeLog"
        ],
        "extensions": [
          ".ChangeLog"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "changelog",
        "scopeName": "source.changelog",
        "path": "./syntaxes/changelog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "changelog",
        "path": "./snippets/snippets.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "changelog-support configuration",
      "properties": {
        "changelog.mailAddress": {
          "type": "string",
          "default": "your@mail.address",
          "description": "Specify your mail address"
        },
        "changelog.dayOfWeekLang": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "ja",
            "none"
          ],
          "description": "Specify language for day of week. Set to 'none' to hide weekday."
        },
        "changelog.weekdayItems": {
          "type": "array",
          "default": [
            "development",
            "meeting"
          ],
          "description": "Specify items for weekdays"
        },
        "changelog.weekendItems": {
          "type": "array",
          "default": [
            "exercise",
            "fishing"
          ],
          "description": "Specify items for weekends"
        },
        "changelog.outlineShowBulletItems": {
          "type": "boolean",
          "default": true,
          "description": "Show bullet item tags in the Outline view."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
